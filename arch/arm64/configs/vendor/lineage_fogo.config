#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_FOGO_DTB=y
# CONFIG_NFC_QTI_I2C is not set
CONFIG_FS_EPOLL_WAKEUP_DEBUG=y
CONFIG_ZRAM_WRITEBACK=y
# CONFIG_THERMAL_STATISTICS is not set
# CONFIG_REGULATOR_QPNP_LCDB is not set
# CONFIG_UFSTW is not set
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_MOT_DONGWOON_OIS_AF_DRIFT=y
CONFIG_AW882XX_STEREO_SMARTPA=y
CONFIG_AW882XX_STEREO_SMARTPA_PRI=y
CONFIG_AW882XX_PARAMS_FROM_BIN=y
CONFIG_AW882XX_MAPSIZE_16K=y
# CONFIG_SND_SOC_AW8838 is not set
#CONFIG_NFC_QTI_I2C=m
CONFIG_MSM_TZ_QSEE_LOG=y
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_TOUCHSCREEN_FTS=m
CONFIG_TOUCHSCREEN_FTS_TS=m
CONFIG_FELICA_MOUNT_BLOCK=y
# CONFIG_UFSHPB is not set
# CONFIG_UFSTW is not set
# CONFIG_SCSI_SKHPB is not set
# CONFIG_MICRON_HPB is not set
CONFIG_NFC=y
CONFIG_SEC_NFC_PRODUCT_N5=y
CONFIG_SEC_NFC=m
CONFIG_SEC_NFC_IF_I2C=y
CONFIG_QUP0_SE2_AP=y
# CONFIG_CAMERA_FLASH_IIC_COMPATIBLE is not set
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
CONFIG_MOT_SENSOR_PRE_POWERUP=y
CONFIG_MMAP_READAROUND_LIMIT=y
CONFIG_MOT_SECURE_CAMERA=y
CONFIG_MOTO_F_USBNET=m
CONFIG_WATCHDOGTEST=m
CONFIG_CNSS_QMI_SVC=m
CONFIG_USB_DWC3_HAPS=m
CONFIG_SPMI_MSM_PMIC_ARB=m
CONFIG_USB_F_DIAG=m
CONFIG_PHY_QCOM_UFS_V3=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_XHCI_PLATFORM=m
CONFIG_QCOM_VADC_COMMON=m
CONFIG_USB_F_GSI=m
CONFIG_PHY_QCOM_UFS_V4=m
CONFIG_REGMAP_SPMI=m
CONFIG_QTI_POLICY_ENGINE_SENSOR=m
CONFIG_USB_DWC3_OF_SIMPLE=m
CONFIG_CNSS_UTILS=m
CONFIG_USB_F_CCID=m
CONFIG_USB_F_CDEV=m
CONFIG_V4L2_MEM2MEM_DEV=m
CONFIG_MSM_PIL=m
CONFIG_PHY_QCOM_UFS_14NM=m
CONFIG_USB_DWC3_QCOM=m
CONFIG_MOTO_UTAGS=m
CONFIG_MMI_RELAY=m
CONFIG_MMI_INFO=m
CONFIG_MMI_ANNOTATE=m
CONFIG_SENSORS_CLASS=m
CONFIG_EXFAT_FS=m
CONFIG_QPNP_ADAPTIVE_CHARGE=m
CONFIG_FINGERPRINT_GOODIX_FOD_MMI=m
CONFIG_FPC_FPS_MMI=m
CONFIG_SARSENSOR_SX937X=m
CONFIG_CAMERA_CCI_INTF=m
CONFIG_INPUT_AWINIC_HAPTIC=y
CONFIG_MMI_SYS_TEMP=m
CONFIG_TOUCHSCREEN_NT36xxx=y
CONFIG_CNSS_QCA6750=y
CONFIG_QCA_CLD_WLAN_DYNAMIC_SINGLE_CHIP_NAME="qca6750"